// No `#version` line: the backend prepends its own preamble, along with the `AKYTHERA_GL` or
// `AKYTHERA_VULKAN` define.
//
// Builds every queued trail's quads from its control edges. One work group row per trail
// (`gl_WorkGroupID.y`), one invocation per quad: the quad between control edges `quad` and
// `quad + 1`.

layout(local_size_x = 64) in;

struct Header {
    uint controlOffset;
    uint controlCount;
    uint vertexOffset;
    uint color;    // RGBA, red in the low byte
    uint light;    // packed light coordinates
};

// One edge across the trail, camera-relative: the origin side and the far side, then the
// texture's u and the alpha the trail's color is multiplied by.
struct Control {
    float sx, sy, sz;
    float ex, ey, ez;
    float u;
    float alpha;
};

// DefaultVertexFormat.PARTICLE, 28 bytes: Position(3×float) UV0(2×float) Color(4×ubyte) UV2(2×short).
struct VertexAttr {
    float px, py, pz;
    float u0, v0;
    uint color;
    uint uv2;
};

layout(std430, binding = 0) readonly buffer HeaderBuffer {
    Header headers[];
};

layout(std430, binding = 1) readonly buffer ControlBuffer {
    Control controls[];
};

layout(std430, binding = 2) writeonly buffer VertexOut {
    VertexAttr out_vert[];
};

void writeVertex(uint index, vec3 position, float u, float v, vec4 color, uint light) {
    out_vert[index].px = position.x;
    out_vert[index].py = position.y;
    out_vert[index].pz = position.z;
    out_vert[index].u0 = u;
    out_vert[index].v0 = v;
    out_vert[index].color = packUnorm4x8(color);
    out_vert[index].uv2 = light;
}

void main() {
    Header h = headers[gl_WorkGroupID.y];
    uint quad = gl_GlobalInvocationID.x;

    if (quad + 1u >= h.controlCount) return;

    Control c0 = controls[h.controlOffset + quad];
    Control c1 = controls[h.controlOffset + quad + 1u];
    vec4 color = unpackUnorm4x8(h.color);
    vec4 color0 = vec4(color.rgb, color.a * c0.alpha);
    vec4 color1 = vec4(color.rgb, color.a * c1.alpha);
    uint base = h.vertexOffset + quad * 4u;

    writeVertex(base, vec3(c0.sx, c0.sy, c0.sz), c0.u, 1.0, color0, h.light);
    writeVertex(base + 1u, vec3(c0.ex, c0.ey, c0.ez), c0.u, 0.0, color0, h.light);
    writeVertex(base + 2u, vec3(c1.ex, c1.ey, c1.ez), c1.u, 0.0, color1, h.light);
    writeVertex(base + 3u, vec3(c1.sx, c1.sy, c1.sz), c1.u, 1.0, color1, h.light);
}
